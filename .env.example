# ==============================================================================
# ZUKA AI CYBERSECURITY SOC ASSISTANT CONFIGURATION
# ==============================================================================

# Database
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/zuka_soc

# Security & Authentication
JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_VALUE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# Supported options: 'ollama', 'gemini', 'openai', or leave blank to prefer local Ollama.
# Cloud providers are used only when explicitly selected and configured.
# If Ollama is unavailable, ZUKA reports that AI explanations are unavailable;
# direct database-backed SOC answers remain available.
# ------------------------------------------------------------------------------
ZUKA_LLM_PROVIDER=ollama

# Optional paid cloud provider: Google Gemini
GEMINI_API_KEY=
ZUKA_GEMINI_MODEL=gemini-2.5-flash

# OpenAI Alternative
# OPENAI_API_KEY=
# ZUKA_OPENAI_MODEL=gpt-4o-mini
# ZUKA_OPENAI_BASE_URL=https://api.openai.com/v1

# Local Ollama Alternative (requires local Ollama server running)
ZUKA_OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
ZUKA_OLLAMA_BASE_URL=http://127.0.0.1:11434
ZUKA_OLLAMA_TIMEOUT=30
ZUKA_OLLAMA_TEMPERATURE=0.2
ZUKA_OLLAMA_MAX_TOKENS=256

# ------------------------------------------------------------------------------
# Notification & Email OTP Settings
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ZUKA SOC
SMTP_USE_TLS=true
SMTP_USE_SSL=false

OTP_SECRET=generate_a_random_32_byte_secret_here
OTP_EXPIRY_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=10

# Web Push Notifications (VAPID)
FRONTEND_BASE_URL=http://127.0.0.1:5173
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:security@zuka.local

# ------------------------------------------------------------------------------
# Simulated Network Defense Module
# ------------------------------------------------------------------------------
# Set to 'true' in hardened production deployments to mandate JWT token validation
# for all /api/defense incident history queries. Defaults to false in dev/test.
REQUIRE_DEFENSE_AUTH=false


# Docker Compose database (use a generated password; URL-encode it in DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=zuka_soc
ENABLE_IN_PROCESS_REPLAY=false

